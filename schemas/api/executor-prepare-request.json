{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:executor-prepare-request:v1",
  "title": "AIOS Executor1 typed preparation request v1",
  "description": "At most 65536 UTF-8 bytes. Duplicate keys are rejected before validation. This request carries intent only; the broker observes the target and baseline and creates the immutable candidate. It grants no build or activation permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "mode", "intent_text", "intent"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "operation": {"const": "prepare"},
    "mode": {"const": "act"},
    "intent_text": {"type": "string", "minLength": 1, "maxLength": 8192, "description": "Nonblank and NUL-free; at most 8192 UTF-8 bytes, checked after schema validation."},
    "intent": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "package_id"],
          "properties": {
            "action": {"enum": ["install_package", "remove_package"]},
            "package_id": {"$ref": "#/$defs/package_id"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "enabled", "package_id"],
          "properties": {
            "action": {"const": "set_postgresql"}, "enabled": {"type": "boolean"},
            "package_id": {"$ref": "#/$defs/package_id"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "enabled", "open_firewall"],
          "properties": {
            "action": {"const": "set_openssh"}, "enabled": {"type": "boolean"}, "open_firewall": {"type": "boolean"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "profile_on_ac", "profile_on_battery"],
          "properties": {
            "action": {"const": "set_power_policy"},
            "profile_on_ac": {"$ref": "#/$defs/power_profile"},
            "profile_on_battery": {"$ref": "#/$defs/power_profile"}
          }
        }
      ]
    }
  },
  "$defs": {
    "package_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*$"},
    "power_profile": {"enum": ["performance", "balanced", "power-saver"]}
  }
}

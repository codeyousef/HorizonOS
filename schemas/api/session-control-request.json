{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:session-control-request:v1",
  "title": "AIOS session control request v1",
  "description": "Serialized UTF-8 request is limited to 65536 bytes before allocation. Duplicate JSON fields are rejected before schema validation. Public D-Bus Submit accepts only the submit operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "operation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["get_capabilities", "get_system_info"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "unit_name"], "properties": {"kind": {"const": "resolve_service"}, "unit_name": {"type": "string", "minLength": 9, "maxLength": 255, "pattern": "^[a-zA-Z0-9_.:@][a-zA-Z0-9_.:@-]*\\.service$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "tool_call"], "properties": {"kind": {"const": "invoke"}, "tool_call": {"type": "object", "additionalProperties": false, "required": ["kind", "action_id", "arguments"], "properties": {"kind": {"const": "tool_call"}, "action_id": {"type": "string", "maxLength": 128}, "arguments": {"type": "object"}}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "request"], "properties": {"kind": {"const": "submit"}, "request": {"$ref": "#/$defs/submit"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "task_id"], "properties": {"kind": {"enum": ["get_status", "cancel", "forget"]}, "task_id": {"$ref": "#/$defs/handle"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "task_id", "after_sequence", "limit"], "properties": {"kind": {"const": "get_events"}, "task_id": {"$ref": "#/$defs/handle"}, "after_sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}}
      ]
    }
  },
  "$defs": {
    "handle": {"type": "string", "minLength": 1, "maxLength": 128},
    "submit": {
      "type": "object", "additionalProperties": false, "required": ["mode", "text", "client_nonce"],
      "properties": {
        "mode": {"enum": ["ask", "act", "diagnose", "automate"]},
        "text": {"type": "string", "minLength": 1, "description": "Nonblank text, at most 60000 UTF-8 bytes; full control envelope at most 65536 bytes."},
        "client_nonce": {"type": "string", "minLength": 1, "description": "At most 128 UTF-8 bytes, bound to this authenticated client and typed request."},
        "context_handles": {"type": "array", "items": {"type": "string"}, "default": []},
        "selected_app_handle": {"type": ["string", "null"]},
        "selected_session_handle": {"type": ["string", "null"]}
      }
    }
  }
}

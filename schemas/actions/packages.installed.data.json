{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:packages.installed:data:v1",
  "title": "packages.installed data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9-]{0,127}$",
                "x-aios-resource": "installed-catalog"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provenance": {
            "type": "string",
            "enum": [
              "managed-system",
              "unmanaged-system",
              "user-profile",
              "ephemeral",
              "unknown"
            ]
          },
          "owner_scope": {
            "type": "string",
            "enum": [
              "system",
              "user"
            ]
          },
          "generation": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "package_id",
          "name",
          "version",
          "provenance",
          "owner_scope",
          "generation"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "packages"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:ui.find:arguments:v1",
  "title": "ui.find arguments v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "name_match": {
          "type": "string",
          "enum": [
            "exact",
            "contains"
          ],
          "default": "exact"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": [],
      "minProperties": 1
    }
  },
  "required": [
    "snapshot_id",
    "selector"
  ]
}

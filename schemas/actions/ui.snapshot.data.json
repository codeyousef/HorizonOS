{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:ui.snapshot:data:v1",
  "title": "ui.snapshot data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "window_handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-aios-resource": "scope-owner-expiry"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 16
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 16
          }
        },
        "required": [
          "node_handle",
          "role",
          "name",
          "states",
          "actions"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_id",
    "window_handle",
    "nodes",
    "truncated"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:ui.select_text:arguments:v1",
  "title": "ui.select_text arguments v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "node_handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "start_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_offset": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "snapshot_id",
    "node_handle",
    "start_offset",
    "end_offset"
  ]
}

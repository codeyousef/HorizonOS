{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:files.read:result:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "pending",
        "cancelled"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "provider",
        "provider_version"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "x-aios-resource": "scope-owner-expiry"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "complete": {
      "type": "boolean"
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-aios-resource": "query-bound-cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_handle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "x-aios-resource": "scope-owner-expiry"
            },
            "range": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "lines"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "start",
                    "end"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "pages"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "start",
                    "end"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "slides"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind",
                    "start",
                    "end"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "cells"
                    },
                    "sheet": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "a1": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"
                    }
                  },
                  "required": [
                    "kind",
                    "sheet",
                    "a1"
                  ]
                }
              ]
            },
            "content": {
              "type": "string",
              "minLength": 0,
              "maxLength": 262144
            },
            "bytes_read": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "provenance": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "missing_scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "minItems": 0,
              "maxItems": 32
            }
          },
          "required": [
            "file_handle",
            "range",
            "content",
            "bytes_read",
            "provenance",
            "missing_scope"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ARGUMENT",
                "UNSUPPORTED_SCHEMA",
                "UNKNOWN_CAPABILITY",
                "UNSUPPORTED_CAPABILITY",
                "TARGET_NOT_FOUND",
                "TARGET_CHANGED",
                "AUTH_REQUIRED",
                "PERMISSION_DENIED",
                "APPROVAL_EXPIRED",
                "PLAN_CHANGED",
                "POLICY_CHANGED",
                "CONFLICT",
                "STALE_EVIDENCE",
                "SECRET_SCOPE_DENIED",
                "INDEX_NOT_READY",
                "MODEL_UNAVAILABLE",
                "MODEL_CRASHED",
                "MODEL_OUTPUT_INVALID",
                "DEADLINE_EXCEEDED",
                "CONTEXT_BUDGET_EXCEEDED",
                "RESOURCE_EXHAUSTED",
                "BUILD_FAILED",
                "ACTIVATION_FAILED",
                "HEALTH_CHECK_FAILED",
                "ROLLBACK_FAILED",
                "PARTIAL_RESULT",
                "CANCELLED",
                "NETWORK_REQUIRED",
                "REBOOT_REQUIRED",
                "RECOVERY_REQUIRED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resource_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "x-aios-resource": "scope-owner-expiry"
                },
                "missing_scope": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "actual": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": []
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "observed_at",
    "source",
    "evidence_ids",
    "complete",
    "next_cursor",
    "data",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file_handle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "x-aios-resource": "scope-owner-expiry"
              },
              "range": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "lines"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "pages"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "slides"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "cells"
                      },
                      "sheet": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "a1": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"
                      }
                    },
                    "required": [
                      "kind",
                      "sheet",
                      "a1"
                    ]
                  }
                ]
              },
              "content": {
                "type": "string",
                "minLength": 0,
                "maxLength": 262144
              },
              "bytes_read": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "provenance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "missing_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 0,
                "maxItems": 32
              }
            },
            "required": [
              "file_handle",
              "range",
              "content",
              "bytes_read",
              "provenance",
              "missing_scope"
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "partial",
              "error",
              "pending",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "partial",
              "error",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "UNSUPPORTED_SCHEMA",
                  "UNKNOWN_CAPABILITY",
                  "UNSUPPORTED_CAPABILITY",
                  "TARGET_NOT_FOUND",
                  "TARGET_CHANGED",
                  "AUTH_REQUIRED",
                  "PERMISSION_DENIED",
                  "APPROVAL_EXPIRED",
                  "PLAN_CHANGED",
                  "POLICY_CHANGED",
                  "CONFLICT",
                  "STALE_EVIDENCE",
                  "SECRET_SCOPE_DENIED",
                  "INDEX_NOT_READY",
                  "MODEL_UNAVAILABLE",
                  "MODEL_CRASHED",
                  "MODEL_OUTPUT_INVALID",
                  "DEADLINE_EXCEEDED",
                  "CONTEXT_BUDGET_EXCEEDED",
                  "RESOURCE_EXHAUSTED",
                  "BUILD_FAILED",
                  "ACTIVATION_FAILED",
                  "HEALTH_CHECK_FAILED",
                  "ROLLBACK_FAILED",
                  "PARTIAL_RESULT",
                  "CANCELLED",
                  "NETWORK_REQUIRED",
                  "REBOOT_REQUIRED",
                  "RECOVERY_REQUIRED"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "x-aios-resource": "scope-owner-expiry"
                  },
                  "missing_scope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "actual": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "check_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": []
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        }
      }
    }
  ]
}

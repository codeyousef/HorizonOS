{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:packages.info:arguments:v1",
  "title": "packages.info arguments v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]{0,127}$",
      "x-aios-resource": "installed-catalog"
    }
  },
  "required": [
    "package_id"
  ]
}

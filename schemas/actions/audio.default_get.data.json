{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:audio.default_get:data:v1",
  "title": "audio.default_get data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "direction": {
      "type": "string",
      "enum": [
        "input",
        "output"
      ]
    },
    "node_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-aios-resource": "scope-owner-expiry"
        },
        {
          "type": "null"
        }
      ]
    },
    "available": {
      "type": "boolean"
    }
  },
  "required": [
    "direction",
    "node_id",
    "available"
  ]
}

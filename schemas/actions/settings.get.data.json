{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:settings.get:data:v1",
  "title": "settings.get data v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "const": "desktop.theme_mode"
        },
        "value": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "ownership": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "unsupported"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "ownership"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "const": "display.idle_seconds"
        },
        "value": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "ownership": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "unsupported"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "ownership"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "const": "keyboard.backlight_percent"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ownership": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "unsupported"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "ownership"
      ]
    }
  ]
}

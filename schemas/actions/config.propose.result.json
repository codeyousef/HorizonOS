{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:config.propose:result:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "pending",
        "cancelled"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "provider",
        "provider_version"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "x-aios-resource": "scope-owner-expiry"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "complete": {
      "type": "boolean"
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-aios-resource": "query-bound-cursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "x-aios-resource": "scope-owner-expiry"
            },
            "requires_approval": {
              "type": "boolean"
            },
            "impact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "recovery_limits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "minItems": 0,
              "maxItems": 32
            },
            "changes": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "services.postgresql.enabled"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "services.postgresql.package_id"
                      },
                      "value": {
                        "const": "postgresql-17"
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "services.postgresql.listen_mode"
                      },
                      "value": {
                        "const": "unix-only"
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "services.openssh.enabled"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "services.openssh.open_firewall"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "power_policy.profile_on_ac"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "power-saver",
                          "balanced",
                          "performance"
                        ]
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "option_id": {
                        "const": "power_policy.profile_on_battery"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "power-saver",
                          "balanced",
                          "performance"
                        ]
                      }
                    },
                    "required": [
                      "option_id",
                      "value"
                    ]
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "plan_id",
            "requires_approval",
            "impact",
            "recovery_limits",
            "changes"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ARGUMENT",
                "UNSUPPORTED_SCHEMA",
                "UNKNOWN_CAPABILITY",
                "UNSUPPORTED_CAPABILITY",
                "TARGET_NOT_FOUND",
                "TARGET_CHANGED",
                "AUTH_REQUIRED",
                "PERMISSION_DENIED",
                "APPROVAL_EXPIRED",
                "PLAN_CHANGED",
                "POLICY_CHANGED",
                "CONFLICT",
                "STALE_EVIDENCE",
                "SECRET_SCOPE_DENIED",
                "INDEX_NOT_READY",
                "MODEL_UNAVAILABLE",
                "MODEL_CRASHED",
                "MODEL_OUTPUT_INVALID",
                "DEADLINE_EXCEEDED",
                "CONTEXT_BUDGET_EXCEEDED",
                "RESOURCE_EXHAUSTED",
                "BUILD_FAILED",
                "ACTIVATION_FAILED",
                "HEALTH_CHECK_FAILED",
                "ROLLBACK_FAILED",
                "PARTIAL_RESULT",
                "CANCELLED",
                "NETWORK_REQUIRED",
                "REBOOT_REQUIRED",
                "RECOVERY_REQUIRED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resource_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "x-aios-resource": "scope-owner-expiry"
                },
                "missing_scope": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "minItems": 1,
                  "maxItems": 32
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "actual": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": []
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "observed_at",
    "source",
    "evidence_ids",
    "complete",
    "next_cursor",
    "data",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plan_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "x-aios-resource": "scope-owner-expiry"
              },
              "requires_approval": {
                "type": "boolean"
              },
              "impact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "recovery_limits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 0,
                "maxItems": 32
              },
              "changes": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "services.postgresql.enabled"
                        },
                        "value": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "services.postgresql.package_id"
                        },
                        "value": {
                          "const": "postgresql-17"
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "services.postgresql.listen_mode"
                        },
                        "value": {
                          "const": "unix-only"
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "services.openssh.enabled"
                        },
                        "value": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "services.openssh.open_firewall"
                        },
                        "value": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "power_policy.profile_on_ac"
                        },
                        "value": {
                          "type": "string",
                          "enum": [
                            "power-saver",
                            "balanced",
                            "performance"
                          ]
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "option_id": {
                          "const": "power_policy.profile_on_battery"
                        },
                        "value": {
                          "type": "string",
                          "enum": [
                            "power-saver",
                            "balanced",
                            "performance"
                          ]
                        }
                      },
                      "required": [
                        "option_id",
                        "value"
                      ]
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              }
            },
            "required": [
              "plan_id",
              "requires_approval",
              "impact",
              "recovery_limits",
              "changes"
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "partial",
              "error",
              "pending",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "partial",
              "error",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "UNSUPPORTED_SCHEMA",
                  "UNKNOWN_CAPABILITY",
                  "UNSUPPORTED_CAPABILITY",
                  "TARGET_NOT_FOUND",
                  "TARGET_CHANGED",
                  "AUTH_REQUIRED",
                  "PERMISSION_DENIED",
                  "APPROVAL_EXPIRED",
                  "PLAN_CHANGED",
                  "POLICY_CHANGED",
                  "CONFLICT",
                  "STALE_EVIDENCE",
                  "SECRET_SCOPE_DENIED",
                  "INDEX_NOT_READY",
                  "MODEL_UNAVAILABLE",
                  "MODEL_CRASHED",
                  "MODEL_OUTPUT_INVALID",
                  "DEADLINE_EXCEEDED",
                  "CONTEXT_BUDGET_EXCEEDED",
                  "RESOURCE_EXHAUSTED",
                  "BUILD_FAILED",
                  "ACTIVATION_FAILED",
                  "HEALTH_CHECK_FAILED",
                  "ROLLBACK_FAILED",
                  "PARTIAL_RESULT",
                  "CANCELLED",
                  "NETWORK_REQUIRED",
                  "REBOOT_REQUIRED",
                  "RECOVERY_REQUIRED"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "x-aios-resource": "scope-owner-expiry"
                  },
                  "missing_scope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "actual": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "check_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": []
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:ui.select_text:data:v1",
  "title": "ui.select_text data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "transaction_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-aios-resource": "scope-owner-expiry"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "pending",
            "unknown"
          ]
        },
        "check_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-aios-resource": "scope-owner-expiry"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "explanation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048
        }
      },
      "required": [
        "outcome",
        "check_id",
        "evidence_ids",
        "explanation"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "node_handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "start_offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_offset": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "operation_id",
    "transaction_id",
    "verification",
    "snapshot_id",
    "node_handle",
    "start_offset",
    "end_offset"
  ]
}

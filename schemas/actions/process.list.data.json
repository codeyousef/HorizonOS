{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:process.list:data:v1",
  "title": "process.list data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "process_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-aios-resource": "scope-owner-expiry"
          },
          "pid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "start_time_ticks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "app_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "x-aios-resource": "scope-owner-expiry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "process_id",
          "pid",
          "start_time_ticks",
          "app_id"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "processes"
  ]
}

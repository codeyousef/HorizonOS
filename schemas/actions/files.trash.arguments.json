{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:files.trash:arguments:v1",
  "title": "files.trash arguments v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "file_handles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "x-aios-resource": "scope-owner-expiry"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "file_handles"
  ]
}

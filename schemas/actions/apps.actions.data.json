{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:apps.actions:data:v1",
  "title": "apps.actions data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "input_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "postcondition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "risk_class": {
            "type": "string",
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4"
            ]
          }
        },
        "required": [
          "action_id",
          "input_schema_id",
          "postcondition_id",
          "risk_class"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "app_id",
    "actions"
  ]
}

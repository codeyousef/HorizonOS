{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:action:files.read:data:v1",
  "title": "files.read data v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "file_handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-aios-resource": "scope-owner-expiry"
    },
    "range": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lines"
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pages"
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "slides"
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cells"
            },
            "sheet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "a1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"
            }
          },
          "required": [
            "kind",
            "sheet",
            "a1"
          ]
        }
      ]
    },
    "content": {
      "type": "string",
      "minLength": 0,
      "maxLength": 262144
    },
    "bytes_read": {
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "missing_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "file_handle",
    "range",
    "content",
    "bytes_read",
    "provenance",
    "missing_scope"
  ]
}

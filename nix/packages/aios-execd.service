[Unit]
Description=Horizon OS authenticated plan executor
After=dbus.service polkit.service aios-bootstrap-identity.service
Requires=dbus.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=dbus
BusName=org.aios.Executor1
ExecStart=@EXECUTABLE@ --serve
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=10
# Only fixed startup stages/finite error codes are emitted by the broker.
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=true
# Native peer/service executable identity requires readonly proc inspection.
# Pathname Unix connect requires socket write permission. Runtime filesystem
# writes remain denied by the read-only mount; only fixed native RPC is exposed.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=
PrivateUsers=false
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
# Homes remain empty. Native own-user unit observation requires the fixed
# runtime bus directories, including users whose manager starts after this unit.
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user
ReadWritePaths=/var/lib/aios/candidates /var/lib/aios/transactions
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=~ptrace mount umount2 reboot kexec_load kexec_file_load
TasksMax=64
MemoryMax=512M
LimitNOFILE=256

[Install]
WantedBy=multi-user.target

[Unit]
Description=Minnerite sealed candidate builder
After=nix-daemon.service local-fs.target aios-bootstrap-identity.service
Requires=nix-daemon.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStart=@EXECUTABLE@
User=aios-builder
Group=aios-builder
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
RuntimeDirectory=aios-build
RuntimeDirectoryMode=0700
StateDirectory=aios/build
StateDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=tmpfs
ReadOnlyPaths=/var/lib/aios/candidates
InaccessiblePaths=-/var/lib/aios/transactions -/var/lib/aios/models
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
TasksMax=512
MemoryMax=2G
CPUWeight=25
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

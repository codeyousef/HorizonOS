[Unit]
Description=Horizon OS isolated CPU inference
Requires=aios-model.socket
After=aios-model.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=@EXECUTABLE@ --model-directory /var/lib/aios/models/normal
User=aios-model
Group=aios-model
SupplementaryGroups=aios-inference
RuntimeDirectory=aios-model
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/aios/models
InaccessiblePaths=-/nix/var/nix/daemon-socket -/run/nix -/run/dbus -/run/user -/run/log -/var/log
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
MemoryHigh=3G
MemoryMax=4G
TasksMax=64
CPUQuota=400%
TimeoutStartSec=10
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30

[Unit]
Description=Project registered desktop settings for AIOS
ConditionUser=!root

[Service]
Type=oneshot
ExecStart=-@CP@ --no-preserve=mode,ownership,timestamps --reflink=never %h/.config/kdeglobals %t/aios/desktop-settings/kdeglobals
ExecStart=-@CP@ --no-preserve=mode,ownership,timestamps --reflink=never %h/.config/powerdevilrc %t/aios/desktop-settings/powerdevilrc
RuntimeDirectory=aios/desktop-settings
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=64M
TasksMax=16
TimeoutStartSec=10

[Unit]
Description=Minnerite authenticated user request broker
After=dbus.socket
Requires=dbus.socket
ConditionUser=!root

[Service]
Type=dbus
BusName=org.aios.Session1
ExecStart=@EXECUTABLE@
RuntimeDirectory=aios
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
# Files1 must compare host UID/inode/mount identity and reopen consented paths
# in the caller's real filesystem view. Unprivileged user-unit mount/network
# isolation creates a child user namespace, so retain the original namespace
# and enforce file authority through descriptor-scoped openat2 grants.
PrivateUsers=no
PrivateNetwork=no
PrivateTmp=no
PrivateDevices=no
ProtectSystem=no
ProtectHome=no
ProtectProc=default
# RestrictSUIDSGID blocks openat2 entirely with ENOSYS, including read-only
# descriptor opens, because seccomp cannot inspect its indirect mode argument.
# Files1 requires openat2's beneath/no-follow/no-new-mount guarantees. Retain
# NoNewPrivileges and zero effective capabilities; fixed cache modes never create SUID
# files and no caller may select a creation mode or execute a scoped file.
RestrictSUIDSGID=no
# An unprivileged user manager cannot drop the bounding set without a child
# user namespace, which changes the UID/filesystem view Files1 must verify.
# Qualification requires empty effective/permitted/inheritable/ambient sets;
# NoNewPrivileges prevents acquiring capabilities from later execs.
AmbientCapabilities=
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=256M
TasksMax=64
TimeoutStartSec=10
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
